<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASF-AutoAchievement plugin.
    Compiled against the ArchiSteamFarm.dll + SteamKit2.dll that ship with
    your ASF install. Set ASF_DIR or drop those DLLs into a sibling ../ASF
    folder. TFM must match the ASF runtime (net10.0 for ASF 6.3.x main).
  -->

  <PropertyGroup>
    <AssemblyName>ASF-AutoAchievement</AssemblyName>
    <RootNamespace>ASF.AutoAchievement</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2.0</Version>
    <Authors>sturq</Authors>
    <Description>ArchiSteamFarm plugin that auto-detects every owned game and unlocks all available achievements (SAM Picker-style, but automated and recurring).</Description>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ASF_DIR Condition=" '$(ASF_DIR)' == '' ">$(MSBuildThisFileDirectory)..\ASF</ASF_DIR>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ArchiSteamFarm">
      <HintPath>$(ASF_DIR)\ArchiSteamFarm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamKit2">
      <HintPath>$(ASF_DIR)\SteamKit2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(ASF_DIR)\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net.Core">
      <HintPath>$(ASF_DIR)\protobuf-net.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Composition.AttributedModel" Version="10.0.0" IncludeAssets="compile" />
  </ItemGroup>

</Project>
